{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "unset npm_config_cache_dir NPM_CONFIG_CACHE_DIR && npm install --legacy-peer-deps --no-audit --no-fund",
  "buildCommand": "unset npm_config_cache_dir NPM_CONFIG_CACHE_DIR && ./node_modules/.bin/vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/tts.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|assets/|favicon\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
